# Copia este archivo a ".env" y rellena tus datos para probar localmente.
# (El .env está en .gitignore: NUNCA se sube a GitHub.)

# --- Gmail (la cuenta que RECIBE los correos del banco) ---
GMAIL_USER=correo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Remitente(s) a vigilar, separados por coma (compras + transferencias enviadas
# + transferencias recibidas, que pueden venir de CUALQUIER banco).
BANK_SENDERS=avisos@tubanco.cl,transferencias@tubanco.cl,notificaciones@otrobanco.cl

# --- Telegram ---
TELEGRAM_TOKEN=123456:ABC-tu-token-de-BotFather
TELEGRAM_CHAT_ID=123456789

# --- Google Sheets ---
# Pega el JSON de la cuenta de servicio en UNA sola línea.
GOOGLE_CREDENTIALS={"type":"service_account", ...}
SHEET_ID=el-id-de-la-planilla-de-la-url

# --- Reglas ---
BILLING_DAY=22
# Opcional: forzar el tipo por dígitos. Ej: 1234:credito,5678:debito
CARD_MAP=1234:credito
# Tu número de cuenta (solo dígitos). Correos de remitentes NO conocidos solo se
# procesan si contienen este número (una transferencia real a tu cuenta).
DEST_ACCOUNT=001234567890

# --- Resumen nocturno ---
# Hora local (0-23) a la que sale el resumen del día.
RESUMEN_HORA=22
# Tema del gráfico que acompaña al resumen: "claro" u "oscuro".
GRAFICO_TEMA=claro
